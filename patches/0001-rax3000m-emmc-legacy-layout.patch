+++ b/target/linux/mediatek/image/filogic.mk
@@ -974,6 +974,20 @@ define Device/cmcc_rax3000m
 endef
 TARGET_DEVICES += cmcc_rax3000m
 
+define Device/cmcc_rax3000m-emmc
